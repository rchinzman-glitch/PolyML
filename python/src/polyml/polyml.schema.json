{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rchinzman-glitch.github.io/PolyML/spec/polyml.schema.json",
  "title": "polyML document",
  "description": "A polyML v0.2 document: people, groups and the relationships between them. v0.1 documents are also valid.",
  "type": "object",
  "required": [
    "polyml",
    "people",
    "relationships"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "polyml": {
      "enum": [
        "0.1",
        "0.2"
      ],
      "description": "Spec version this document follows."
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "vocab": {
      "$ref": "#/$defs/vocab"
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      },
      "default": []
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "Stable, document-unique identifier."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
      "description": "ISO 8601 date with optional precision: YYYY, YYYY-MM or YYYY-MM-DD."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "ended",
        "unknown"
      ]
    },
    "style": {
      "enum": [
        "hierarchical",
        "non-hierarchical",
        "relationship-anarchy"
      ],
      "description": "How a person or network approaches relationship structure. relationship-anarchy has its own rules (spec \u00a77)."
    },
    "priority": {
      "enum": [
        "anchor",
        "primary",
        "secondary",
        "none"
      ]
    },
    "distance": {
      "enum": [
        "nesting",
        "local",
        "long-distance"
      ]
    },
    "contact": {
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "rarely"
      ]
    },
    "closeness": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "style": {
          "$ref": "#/$defs/style",
          "description": "Default style for everyone in the document; a person's own style overrides it."
        }
      }
    },
    "vocab": {
      "type": "object",
      "additionalProperties": false,
      "description": "Document-local additions to the core vocabularies.",
      "properties": {
        "relationship_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          }
        },
        "group_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          }
        },
        "dynamics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          }
        }
      }
    },
    "term": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "agreement": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "text": {
          "type": "string"
        },
        "since": {
          "$ref": "#/$defs/date"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        }
      }
    },
    "period": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "from": {
          "$ref": "#/$defs/date"
        },
        "to": {
          "$ref": "#/$defs/date"
        },
        "note": {
          "type": "string"
        },
        "types": {
          "$ref": "#/$defs/terms",
          "description": "Types during this period. Omitted: the bond's current types."
        },
        "dynamics": {
          "$ref": "#/$defs/terms",
          "description": "Dynamics during this period. Omitted: the bond's current dynamics."
        }
      }
    },
    "person": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "description": "Display name."
        },
        "pronouns": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/style",
          "description": "Overrides meta.style for this person."
        },
        "location": {
          "type": "string",
          "description": "Coarse location, such as a city or region."
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "status": {
          "$ref": "#/$defs/status",
          "default": "active"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "membership": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "object",
          "required": [
            "person"
          ],
          "additionalProperties": false,
          "properties": {
            "person": {
              "$ref": "#/$defs/id"
            },
            "from": {
              "$ref": "#/$defs/date"
            },
            "to": {
              "$ref": "#/$defs/date"
            },
            "role": {
              "type": "string",
              "description": "Role within the group, such as co-parent."
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Core: house, pod, polycule, family, triad, quad, other; or a vocab.group_types id."
        },
        "parent": {
          "$ref": "#/$defs/id",
          "description": "Enclosing group id."
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/membership"
          }
        },
        "types": {
          "$ref": "#/$defs/terms",
          "description": "Set when the group relates as one unit (spec \u00a74.1)."
        },
        "dynamics": {
          "$ref": "#/$defs/terms"
        },
        "since": {
          "$ref": "#/$defs/date"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/period"
          }
        },
        "agreements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agreement"
          }
        },
        "status": {
          "$ref": "#/$defs/status",
          "default": "active"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "party": {
      "type": "object",
      "required": [
        "person"
      ],
      "additionalProperties": false,
      "properties": {
        "person": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "parties",
        "types"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "parties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/party"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Exactly two people: one pairing."
        },
        "types": {
          "$ref": "#/$defs/terms",
          "description": "Current relationship types. May be empty only under relationship anarchy."
        },
        "dynamics": {
          "$ref": "#/$defs/terms"
        },
        "priority": {
          "$ref": "#/$defs/priority",
          "description": "Not allowed under relationship anarchy."
        },
        "distance": {
          "$ref": "#/$defs/distance"
        },
        "nesting": {
          "type": "boolean",
          "description": "Deprecated in 0.2: same as distance: nesting."
        },
        "closeness": {
          "$ref": "#/$defs/closeness"
        },
        "contact": {
          "$ref": "#/$defs/contact"
        },
        "status": {
          "$ref": "#/$defs/status",
          "default": "active"
        },
        "since": {
          "$ref": "#/$defs/date"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/period"
          }
        },
        "agreements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agreement"
          }
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
